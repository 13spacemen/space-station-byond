world/turf=/turf/Space
turf
	icon='Floors.dmi'
	Space
		icon_state="Space"
		N2=0
		O2=0
		Ar=0
		CO2=0
		Ne=0
		He=0
		CH4=0
		Kr=0
		H2=0
		N2O=0
		CO=0

	Floors
		icon_state="Floor"
		Floor

		Grating
			icon_state="Grate"

	var
		Active=1
		Inactive=0
		Secured=1

		Pressure=100	//Pressure=  (10000/Sum(Gas))*100
						//Gas				%Earth Atmos		Notes
		N2=78084		//Nitrogen			78.084%				Colorless, odorless, tasteless, inert
		O2=20946		//Oxygen			20.946% 			Colorless, odorless, tasteless
		Ar=9340			//Argon				0.9340%				Colorless, odorless, tasteless, nontoxic, inert, stops fire
		CO2=383			//Carbon dioxide	0.0383%				Colorless, odorless
		//Large amounts sour cause stinging in nose and throat, over 15x normal unhealthy over 150x normal dangerous
		Ne=18			//Neon				0.001818%
		He=5			//Helium			0
		CH4=1			//Methane			0
		Kr=1			//Krypton			0
		H2=1			//Hydrogen			0
//		H2O=10			//Water Vapor		0
		N2O=0			//Nitrous Oxide		0
		CO=0			//Carbon Monoxide	0
		Open=0



turf/Floors/System
	var/Increasing=1
	New()
		.=..()
		spawn(10) SysTurfManage()
	proc/SysTurfManage()
		while(src)
			if(!src)return
			if(Increasing)
				N2+=78084
				O2+=20946
				Ar+=9340
				CO2+=383
				Ne+=18
				He+=5
				CH4+=1
				Kr+=1
				H2+=1
				N2O+=1
				CO+=1
			else
				N2/=10
				O2/=10
				Ar/=10
				CO2/=10
				Ne/=10
				He/=10
				CH4/=10
				Kr/=10
				H2/=10
				N2O/=10
				CO/=10
			sleep(10)

	Increase


	Decrease
		Increasing=0

world

	proc/TTCUpdate()
		TTC=0
		ActiveTurfList=new /list
		for(var/turf/Floors/T)
			TTC++
			spawn() TurfPressure(T)
			//if(locate(/obj/Walls) in T) continue
			//if(locate(/obj/Windows/WindowFull) in T)continue
			ActiveTurfList+=T
			sleep(0)

		world<<"TTC (Total Turf Count): [TTC]"
		//spawn() spawn(300) TTCUpdate()

var/list/ActiveTurfList[0]

world
	proc/Equalize()
		//var/DebugCounter=0
		var/Counter=0 	//Keeps track of how many turfs have been calculated, used for lag control
		var/Diff=0      //A 'temporary' variable used for adding up differences
		var/turf/T      //Target turf in calculations
		var/SR=1/2		//**Spread Rate: This can be changed to modify the speed air balances itself out**//
		var/Push=0		//Pushing power generated by air movement, used for deciding how heavy something must be to push it
		var/Switch=0    //Used to randomize the airflow a little bit
		var/Step=0      //Used in the loop to determine which direction to target a turf
		var/NoChangeCounter=0 //Decides if a turf is inactive and should be removed from the active turf list
		var/ODIR		//Original Direction, for pushing objects
		var/Failsafe	//Just by the off chance there is absolutely no air fluctuation in the whole world, this failsafe is here
//to prevent an infinite loop that would crash the game

		while(world) //Self explanatory... a never ending loop
			Switch=rand(1,4)	//Randomize the turf equalization order, just for funzies
			Step=0				//Set step=0 for loop
			Restart				//Tag for gotos
			Failsafe=0
			for(var/turf/Floors/S in ActiveTurfList)	//Loop through every turf that isn't inactive
				Failsafe=1								//Failsafe function to prevent crashes
				if(!istype(S,/turf/Floors/))			//If for whatever reason the turf in the list isn't of the floor type
					ActiveTurfList-=S					//Remove it from the active list
					continue							//And move on to the next turf in the list
	//	//	//	//	//	//	//

				if(locate(/obj/Walls)in S)				//Air doesn't travel through walls
					S.Active=0							//S is no longer active
					ActiveTurfList-=S					//Remove it from the list to avoid unnecessary checks later
					continue							//Continue on to the next turf in the list

				if(locate(/obj/Windows/WindowFull)in S) //WindowFull is basically a wall, so do the same as above
					S.Active=0							//
					ActiveTurfList-=S					//
					continue							//


			//	Step1

				switch(Switch)								//Randomization, keep things fun
					if(1)									//**//
						if(!Step) T=locate(S.x,S.y+1,S.z)	//**//
						if(Step==1)T=locate(S.x,S.y-1,S.z)	//**//
						if(Step==2)T=locate(S.x+1,S.y,S.z)	//**//
						if(Step==3)T=locate(S.x-1,S.y,S.z)	//**//
					if(2)									//\///
						if(!Step) T=locate(S.x,S.y-1,S.z)
						if(Step==1)T=locate(S.x+1,S.y,S.z)
						if(Step==2)T=locate(S.x-1,S.y,S.z)
						if(Step==3)T=locate(S.x,S.y+1,S.z)
					if(3)
						if(!Step) T=locate(S.x+1,S.y,S.z)
						if(Step==1)T=locate(S.x-1,S.y,S.z)
						if(Step==2)T=locate(S.x,S.y+1,S.z)
						if(Step==3)T=locate(S.x,S.y-1,S.z)
					if(4)
						if(!Step) T=locate(S.x-1,S.y,S.z)
						if(Step==1)T=locate(S.x,S.y+1,S.z)
						if(Step==2)T=locate(S.x,S.y-1,S.z)
						if(Step==3)T=locate(S.x+1,S.y,S.z)
				if(!T)goto Step2							//If T doesnt exist... move on to the next target turf

				if(locate(/obj/Walls)in T)	goto Step2	//If there is a wall in the target, skip to the end of this calculation

				if(locate(/obj/Windows/WindowFull)in T) goto Step2	//Same for full windows

				for(var/obj/Doors/W in S)		//Gotta check if there is a door in between the two turfs
					if(!W.Open)					//If the door isn't open then check for collisions
						if(istype(W,/obj/Doors/SideDoor))
							if(get_dir(S,T)==WEST) if(W.dir==WEST)
								goto Step2
								continue
							if(get_dir(S,T)==SOUTH) if(W.dir==SOUTH)
								goto Step2
								continue
							if(get_dir(S,T)==EAST) if(W.dir==EAST)
								goto Step2
								continue
							if(get_dir(S,T)==NORTH) if(W.dir==NORTH)
								goto Step2
								continue
						else if(istype(W,/obj/Doors))
							goto Step2
							continue

				for(var/obj/Windows/Window/W in S) if(S.Secured)	//Same checking for windows, if they are secured
					if(get_dir(S,T)==WEST) if(W.dir==WEST)
						goto Step2
						continue
					if(get_dir(S,T)==SOUTH) if(W.dir==SOUTH)
						goto Step2
						continue
					if(get_dir(S,T)==EAST) if(W.dir==EAST)
						goto Step2
						continue
					if(get_dir(S,T)==NORTH) if(W.dir==NORTH)
						goto Step2
						continue

				for(var/obj/Doors/W in T)		//Since you can have windows on either end of a turf, you have to check
					if(!W.Open)					//The target as well as the source
						if(istype(W,/obj/Doors/SideDoor))
							if(get_dir(S,T)==WEST) if(W.dir==EAST)
								goto Step2
								continue
							if(get_dir(S,T)==SOUTH) if(W.dir==NORTH)
								goto Step2
								continue
							if(get_dir(S,T)==EAST) if(W.dir==WEST)
								goto Step2
								continue
							if(get_dir(S,T)==NORTH) if(W.dir==SOUTH)
								goto Step2
								continue
						else if(istype(W,/obj/Doors))
							goto Step2
							continue

				for(var/obj/Windows/Window/W in T) if(W.Secured)
					if(get_dir(S,T)==WEST) if(W.dir==EAST)
						goto Step2
						continue
					if(get_dir(S,T)==SOUTH) if(W.dir==NORTH)
						goto Step2
						continue
					if(get_dir(S,T)==EAST) if(W.dir==WEST)
						goto Step2
						continue
					if(get_dir(S,T)==NORTH) if(W.dir==SOUTH)
						goto Step2
						continue

				if(istype(T,/turf/Space))	//If the target turf is a space tile
					if(S.N2) S.N2=round(S.N2*rand(0.1,0.2),0.1)		//Get rid of a lot of gasses!
					if(S.O2) S.O2=round(S.O2*rand(0.1,0.2),0.1)
					if(S.Ar) S.Ar=round(S.Ar*rand(0.1,0.2),0.1)
					if(S.CO2) S.CO2=round(S.CO2*rand(0.1,0.2),0.1)
					if(S.Ne) S.Ne=round(S.Ne*rand(0.1,0.2),0.1)
					if(S.He) S.He=round(S.He*rand(0.1,0.2),0.1)
					if(S.CH4) S.CH4=round(S.CH4*rand(0.1,0.2),0.1)
					if(S.Kr) S.Kr=round(S.Kr*rand(0.1,0.2),0.1)
					if(S.H2) S.H2=round(S.H2*rand(0.1,0.2),0.1)
					if(S.N2O) S.N2O=round(S.N2O*rand(0.1,0.2),0.1)
					if(S.CO) S.CO=round(S.CO*rand(0.1,0.2),0.1)
					goto Step2						//Then go to the end


				if(S.N2<2)		//Just a quick check to see if the gasses are incredibly low
					S.N2=0		//And if they are, zero them out to avoid wasting processing power
					if(S.O2<2) S.O2=0	//These gases arent checked unless N20 is low to avoid
					if(S.Ar<2) S.Ar=0	//Wasting more processing power
					if(S.CO2<2) S.CO2=0
					if(S.Ne<2) S.Ne=0
					if(S.He<2) S.He=0
					if(S.CH4<2) S.CH4=0
					if(S.Kr<2) S.Kr=0
					if(S.H2<2) S.H2=0
					if(S.N2O<2) S.N2O=0
					if(S.CO<2) S.CO=0

				Push=0			//Reset push to 0 from past loops
				NoChangeCounter=11	//This is used to see if there was no difference between the turfs

				if(S.N2!=T.N2)	//Check if the gases are equal first to avoid wasting processing
					NoChangeCounter--	//Note that there was a change and lower the counter
					if(S.N2<=T.N2*(1.02)&&S.N2>=T.N2*0.98)	//If the two gases are within 2% up or down of each other
						S.N2=(T.N2+S.N2)/2					//Just average them and even them out
						T.N2=S.N2							//That way they don't bounce back and forth trying to even
					else									//If they arent very close
						Diff=(S.N2-T.N2)*SR					//Calculate the difference according to the spread rate
						S.N2-=Diff							//Apply the difference to the source and target
						T.N2+=Diff
						Push+=Diff							//Add the amount of gas moved to the push counter, for later use
				if(S.O2!=T.O2)
					NoChangeCounter--
					if(S.O2<=T.O2*(1.02)&&S.O2>=T.O2*0.98)	//Lather rinse repeat for each individual gas
						S.O2=(T.O2+S.O2)/2
						T.O2=S.O2
					else
						Diff=(S.O2-T.O2)*SR
						S.O2-=Diff
						T.O2+=Diff
						Push+=Diff
				if(S.Ar!=T.Ar)
					NoChangeCounter--
					if(S.Ar<=T.Ar*(1.02)&&S.Ar>=T.Ar*0.98)
						S.Ar=(T.Ar+S.Ar)/2
						T.Ar=S.Ar

					else
						Diff=(S.Ar-T.Ar)*SR
						S.Ar-=Diff
						T.Ar+=Diff
						Push+=Diff
				if(S.CO2!=T.CO2)
					NoChangeCounter--
					if(S.CO2<=T.CO2*(1.02)&&S.CO2>=T.CO2*0.98)
						S.CO2=(S.CO2+T.CO2)/2
						T.CO2=S.CO2
					else
						Diff=(S.CO2-T.CO2)*SR
						S.CO2-=Diff
						T.CO2+=Diff
						Push+=Diff
				if(S.Ne!=T.Ne)
					NoChangeCounter--
					if(S.Ne<=T.Ne*(1.02)&&S.Ne>=T.Ne*0.98)
						S.Ne=(T.Ne+S.Ne)/2
						T.Ne=S.Ne
					else
						Diff=(S.Ne-T.Ne)*SR
						S.Ne-=Diff
						T.Ne+=Diff
						Push+=Diff
				if(S.He!=T.He)
					NoChangeCounter--
					if(S.He<=T.He*(1.02)&&S.He>=T.He*0.98)
						S.He=(S.He+T.He)/2
						T.He=S.He

					else
						Diff=(S.He-T.He)*SR
						S.He-=Diff
						T.He+=Diff
						Push+=Diff
				if(S.CH4!=T.CH4)
					NoChangeCounter--
					if(S.CH4<=T.CH4*(1.02)&&S.CH4>=T.CH4*0.98)
						S.CH4=(S.CH4+T.CH4)/2
						T.CH4=S.CH4
					else
						Diff=(S.CH4-T.CH4)*SR
						S.CH4-=Diff
						T.CH4+=Diff
						Push+=Diff
				if(S.Kr!=T.Kr)
					NoChangeCounter--
					if(S.Kr<=T.Kr*(1.02)&&S.Kr>=T.Kr*0.98)
						S.Kr=(S.Kr+T.Kr)/2

					else
						Diff=(S.Kr-T.Kr)*SR
						S.Kr-=Diff
						T.Kr+=Diff
						Push+=Diff
				if(S.H2!=T.H2)
					NoChangeCounter--
					if(S.H2<=T.H2*(1.02)&&S.H2>=T.H2*0.98)
						S.H2=(S.H2+T.H2)/2
						T.H2=S.H2

					else
						Diff=(S.H2-T.H2)*SR
						S.H2-=Diff
						T.H2+=Diff
						Push+=Diff
				if(S.N2O!=T.N2O)
					NoChangeCounter--
					if(S.N2O<=T.N2O*(1.02)&&S.N2O>=T.N2O*0.98)
						S.N2O=(S.N2O+T.N2O)/2
						T.N2O=S.N2O

					else
						Diff=(S.N2O-T.N2O)*SR
						S.N2O-=Diff
						T.N2O+=Diff
						Push+=Diff
				if(S.CO!=T.CO)
					NoChangeCounter--
					if(S.CO<=T.CO*(1.02)&&S.CO>=T.CO*0.98)
						S.CO=(S.CO+T.CO)/2
						T.CO=S.CO
					else
						Diff=(S.CO-T.CO)*SR
						S.CO-=Diff
						T.CO+=Diff
						Push+=Diff


				Push/=4				//Cutting down the push strength
				for(var/atom/movable/A in S)		//Push calculations!
					if(A.ForcedMove<1&&A.Secured==0)	//ForcedMove is for preventing overpushing one object
														//And if it is secured we don't want to move it either
						if(Push>0)						//If the push is positive
							if(A.Weight*2<Push)			//See if there is enough push to move something
								if(istype(A,/mob/Player)) if(A:Movement==1) if(A.Weight*2*2>Push) goto DidntPush
								if(istype(A,/mob/Player)) if(A:Movement==0) if(A.Weight*2*4>Push) goto DidntPush
		//If you are walking or standing still then you can resist the push of the air a bit better than if you are running
								if(!locate(/obj/Walls) in get_step(A,get_dir(S,T))) //Collision check
									ODIR=A.dir
									step(A,get_dir(S,T)) //Move!
									A.dir=ODIR
									if(A.Weight<50)if(rand(1,3)==2)	//Light stuff gets blown around lots! More realistic look
										var/RDIR=pick(NORTH,EAST,SOUTH,WEST)		//Random direction
										if(!locate(/obj/Walls) in get_step(A,RDIR)) step(A,RDIR)	//Collision check
									goto DidPush
						else if(Push<0) 		//Same thing here, just reversed directions

							if(A.Weight*2<Push*-1)
								if(istype(A,/mob/Player)) if(A:Movement==1) if(A.Weight*2*2>Push) goto DidntPush
								if(istype(A,/mob/Player)) if(A:Movement==0) if(A.Weight*2*4>Push) goto DidntPush
								if(!locate(/obj/Walls) in get_step(A,get_dir(T,S)))
									ODIR=A.dir
									step(A,get_dir(T,S))
									A.dir=ODIR
									if(A.Weight<50)if(rand(1,3)==2)
										var/RDIR=pick(NORTH,EAST,SOUTH,WEST)
										if(!locate(/obj/Walls) in get_step(A,RDIR)) step(A,RDIR)
									goto DidPush

						goto DidntPush
						DidPush
						A.ForcedMove++	//Prevents a mob from being blown around a stupid amount
						spawn(rand(3,7)) if(A) A.ForcedMove--	//Half a second on average is a good amount
						DidntPush					//Don't want to do that if they didn't get moved...


				if(abs(Push)>50&&WindAnimations) if(rand(1,5)<=WindAnimations)	//Wind animations!
					if(Push>0) //Efficiency check
						for(var/obj/System/Wind/XX in S) if(XX.dir==get_dir(S,T))
							if(XX.icon_state=="Light"&&abs(Push<300)) goto WindSkip
							else if(XX.icon_state=="Medium"&&abs(Push<600)) goto WindSkip
							else if(XX.icon_state=="Heavy"&&abs(Push<1200)) goto WindSkip

					else if(Push<0) //To avoid duplication
						for(var/obj/System/Wind/XX in S) if(XX.dir==get_dir(T,S))
							if(XX.icon_state=="Light"&&abs(Push<300)) goto WindSkip
							else if(XX.icon_state=="Medium"&&abs(Push<600)) goto WindSkip
							else if(XX.icon_state=="Heavy"&&abs(Push<1200)) goto WindSkip

					var/obj/System/Wind/WW=new
					if(abs(Push)>25) WW.icon_state="Light"
					if(abs(Push)>300) WW.icon_state="Medium"
					if(abs(Push)>600) WW.icon_state="Heavy"
					if(abs(Push)>1200) WW.icon_state="Very Heavy"

					if(Push>0)
						flick(WW.icon_state,WW)
						WW.dir=get_dir(S,T)
						WW.loc=S

					if(Push<0)
						flick(WW.icon_state,WW)
						WW.dir=get_dir(T,S)
						WW.loc=T
					spawn(4) del WW
				WindSkip

				if(NoChangeCounter>10)	//If no gases changed
					S.Inactive++		//Add a counter to the turfs inactivity variables
					T.Inactive++
					if(S.Inactive>20)	//If the source has been too inactive
						ActiveTurfList-=S	//Turn it off
						S.Inactive=0		//Reset the counter to 0
						S.Active=0			//Make it not active anymore

				else
					S.Inactive=0		//If gases did change
					T.Inactive=0		//Reset counters to 0
					if(!T.Active)		//If T isn't active
						ActiveTurfList+=T	//Activate it and put it in the list
						T.Active=1
						T.Inactive=0

				Step2		//Tag for goto
				Counter++	//Increase counter by 1, for lag reduction

				if(Counter>=TTC/LagReduction)	//If the counter is over the total turfs divided by the current lag factor
					sleep(1)					//sleep for 1/10 of a second
					Counter=0					//and set the counter to 0
			sleep(0)
			if(Failsafe==0) sleep(1)
			Step++					//Increase the step by 1
			if(Step<4)goto Restart	//And loop

			//if(rand(0,1)) sleep(1)



obj/System/Wind
	name=""
	mouse_opacity=0
	invisibility=0
	icon='Wind.dmi'
	icon_state="Light"
	Light/icon_state="Light"
	Heavy/icon_state="Heavy"



/* WORLD PROC ***

	proc/Equalize()

		//var/DebugCounter=0
		var/Counter=0
		var/Diff=0
		var/turf/T
		var/SR=1/5 //Spread Rate
		var/Push=0
		var/Switch=0
		var/Step=0

		while(1)
			for(var/turf/Floors/S in world)
				SR=1/rand(3,7)
				Switch=rand(1,4)
				if(locate(/obj/Walls)in S)
					goto TheEnd
					continue


				switch(Switch)
					if(1)T=locate(S.x,S.y+1,S.z)
					if(2)T=locate(S.x,S.y-1,S.z)
					if(3)T=locate(S.x+1,S.y,S.z)
					if(4)T=locate(S.x-1,S.y,S.z)
				Step1

				if(!T)goto Step2



				for(var/obj/Doors/W in S)
					if(!W.Open)
						if(istype(W,/obj/Doors/SideDoor))
							if(get_dir(S,T)==WEST) if(W.dir==WEST)
								goto Step2
								continue
							if(get_dir(S,T)==SOUTH) if(W.dir==SOUTH)
								goto Step2
								continue
							if(get_dir(S,T)==EAST) if(W.dir==EAST)
								goto Step2
								continue
							if(get_dir(S,T)==NORTH) if(W.dir==NORTH)
								goto Step2
								continue
						else if(istype(W,/obj/Doors))
							goto Step2
							continue

				for(var/obj/Doors/W in T)
					if(!W.Open)
						if(istype(W,/obj/Doors/SideDoor))
							if(get_dir(S,T)==WEST) if(W.dir==EAST)
								goto Step2
								continue
							if(get_dir(S,T)==SOUTH) if(W.dir==NORTH)
								goto Step2
								continue
							if(get_dir(S,T)==EAST) if(W.dir==WEST)
								goto Step2
								continue
							if(get_dir(S,T)==NORTH) if(W.dir==SOUTH)
								goto Step2
								continue
						else if(istype(W,/obj/Doors))
							goto Step2
							continue


